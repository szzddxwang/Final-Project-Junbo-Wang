<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign-up</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            background-color: #0d47a1;
        }

        .container {
            width: 550px;
            padding: 3rem;
            background-color: white;
            border-radius: 12px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
            text-align: center;
        }

        .container h2 {
            font-size: 1.3rem;
            margin-bottom: 1.5rem;
            color: #000;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 15px;
            margin-bottom: 1.5rem;
        }

        .form-group input {
            width: 100%;
            padding: 12px;
            border: 1px solid #ccc;
            border-radius: 6px;
            font-size: 1rem;
        }

        .error-message {
            display: none;
            color: red;
            font-size: 0.9rem;
            margin-top: 5px;
        }

        .signup-btn {
            background-color: #2c6bed;
            color: white;
            border: none;
            padding: 12px 20px;
            font-size: 1rem;
            border-radius: 6px;
            cursor: pointer;
            width: 100%;
        }

        .signup-btn:hover {
            background-color: #1b4db5;
        }
    </style>
</head>
<body>
    <div class="container">
        <h2>$SIGNUP_INSTRUCTIONS</h2>
      <form id="signupForm" action="/forgotpassword/v1/signup" method="post">
    <div class="form-group">
        <input type="text" id="fullName" name="UserFullName" placeholder="$YOUR_FULL_NAME" required>
        <input type="email" id="email" name="EmailAddress" placeholder="$EMAIL_ADDRESS" required>
    </div>
    <button type="submit" class="signup-btn">$SIGN_UP</button>
</form>
</body>
</html>
