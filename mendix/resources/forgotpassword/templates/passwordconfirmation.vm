<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>$PASSWORD_CHANGED_SUCCESSFULLY</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            background-color: #0d47a1; /* Siemens blue */
        }

        .container {
            width: 550px;
            padding: 3rem;
            background-color: white;
            border-radius: 12px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
            text-align: center;
        }

        .container h2 {
            font-size: 1.3rem;
            margin-bottom: 1.5rem;
            color: #000;
        }

        .submit-btn { /* This style will be applied to our "Go to Login" link */
            background-color: #2c6bed; /* Siemens secondary blue */
            color: white;
            border: none;
            padding: 12px 20px;
            font-size: 1rem;
            border-radius: 6px;
            cursor: pointer;
            width: 100%;
            text-decoration: none; /* Remove underline from link */
            display: inline-block; /* Make it behave like a button */
            margin-top: 1.5rem; /* Add some space above the button */
        }

        .submit-btn:hover {
            background-color: #1b4db5; /* Darker Siemens secondary blue on hover */
        }

        .success-message {
            font-size: 1.1rem;
            line-height: 1.6;
            margin-bottom: 1.5rem;
            color: #333;
        }
    </style>
</head>
<body>
    <div class="container">
        <h2>$PASSWORD_CHANGED_SUCCESSFULLY</h2>
        <p class="success-message">$PASSWORD_CHANGED_SUCCESSFULLY_MESSAGE</p>
        <input type="hidden" id="uuidInput" name="UUID" value="$UUID" />
        <a href="#" id="loginNowBtn" class="submit-btn">$LOGIN_NOW</a>

        <script>
            // Get the UUID from the hidden input field
            var uuid = document.getElementById('uuidInput').value;

                var form = document.createElement('form');
                document.body.appendChild(form);
                form.method = 'post';
                form.action = '/signin/';
	            var input = document.createElement('input');
		            input.type = 'hidden';
		            input.name = 'uuid';
                    input.value = uuid;
                form.appendChild(input);

                setTimeout(function() {
                    form.submit();
                }, 800); // 0.8 second delay before auto-submission

        </script>
    </div>
</body>
</html>