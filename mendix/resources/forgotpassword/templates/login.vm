<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            background-color: #0d47a1;
        }

        .container {
            background-color: #fff;
            padding: 3rem;
            border-radius: 12px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
            width: 650px; /* Increased width */
            text-align: center;
        }

        .container h1 {
            margin-bottom: 1.5rem;
        }

        .input-group {
            text-align: left;
            margin-bottom: 1.5rem;
        }

        .input-group label {
            font-weight: bold;
            display: block;
            margin-bottom: 0.5rem;
        }

        .input-group input {
            width: 100%;
            padding: 12px;
            border: 1px solid #ccc;
            border-radius: 6px;
        }

        .button-group {
            display: flex;
            justify-content: space-between;
            margin-top: 1.5rem;
        }

        .button-group button {
            flex: 1;
            padding: 12px;
            border: 2px solid #0d47a1;
            border-radius: 6px;
            cursor: pointer;
            margin: 0 8px;
        }

        .button-group .signin {
            background-color: #0d47a1;
            color: white;
            border: none;
        }

        .button-group .forgot-password,
        .button-group .signup {
            background-color: transparent;
            color: #0d47a1;
        }

        .button-group .signin:hover {
            background-color: #08306e;
        }

        .button-group .forgot-password:hover,
        .button-group .signup:hover {
            background-color: #e3f2fd;
        }

        /* Style for validation messages */
        .error-message {
            color: red;
            font-size: 0.9em;
            margin-top: 5px;
            text-align: left;
        }
    </style>
</head>
<body>
    
    <div class="container">
    #if( $errorMessage )
    <div style="color:red; font-weight:bold;">
        $errorMessage
    </div>
    #end
    <form id="loginForm" action="/forgotpassword/v1/login" method="post">
        <div class="input-group">
            <label for="username">$USERNAME</label>
            <input type="text" id="username" name="username" placeholder="$ENTER_YOUR_USERNAME">
            <div id="usernameError" class="error-message"></div>
        </div>
        <div class="input-group">
            <label for="password">$PASSWORD</label>
            <input type="password" id="password" name="password" placeholder="$ENTER_YOUR_PASSWORD">
            <div id="passwordError" class="error-message"></div>
        </div>
        <div class="button-group">
            <button class="signin" type="submit">$LOGIN</button>
            <button type ="button" class="forgot-password" onclick="window.location.href=window.location.origin + '/forgotpassword/v1/forgotpassword'">$FORGOT_PASSWORD</button>
            <button type ="button" class="signup" onclick="window.location.href=window.location.origin + '/forgotpassword/v1/signup'">$SIGN_UP</button>
        </div>
    </form>
    </div>

    <script>
        document.getElementById('loginForm').addEventListener('submit', function(event) {
            const usernameInput = document.getElementById('username');
            const passwordInput = document.getElementById('password');
            const usernameError = document.getElementById('usernameError');
            const passwordError = document.getElementById('passwordError');

            // Clear previous error messages
            $errorMessage = '';
            usernameError.textContent = '';
            passwordError.textContent = '';

            let isValid = true;

            if (usernameInput.value.trim() === '') {
                usernameError.textContent = '$USERNAME_EMPTY_ERROR';
                isValid = false;
            }

            if (passwordInput.value.trim() === '') {
                passwordError.textContent = '$PASSWORD_EMPTY_ERROR';
                isValid = false;
            }

            if (!isValid) {
                event.preventDefault(); // Stop the form from submitting if there are errors
            }
        });
    </script>
</body>
</html>